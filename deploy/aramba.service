[Unit]
Description=Aramba API
After=network.target

[Service]
User=aramba
Group=aramba
WorkingDirectory=/opt/aramba
ExecStart=/opt/aramba/.venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
